--- a/shopcart/pricing.py
+++ b/shopcart/pricing.py
@@ -1,5 +1,8 @@
 """Pricing helpers for the shopping cart."""
 
+class InvalidCouponError(KeyError):
+    pass
+
 COUPONS = {"SAVE10": 10, "SAVE20": 20}  # percent off
 
 
@@ -11,5 +14,8 @@ def apply_percent_discount(amount: float, percent: float) -> float:
 
 
 def coupon_percent(code: str) -> float:
-    """Look up a coupon code. Unknown codes raise KeyError."""
-    return COUPONS[code.upper()]
+    """Look up a coupon code. Unknown codes raise InvalidCouponError."""
+    try:
+        return COUPONS[code.upper()]
