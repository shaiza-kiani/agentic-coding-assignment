--- a/shopcart/cart.py
+++ b/shopcart/cart.py
@@ -10,8 +10,10 @@ class Cart:
     def add_item(self, sku: str, price: float, qty: int = 1):
         if qty <= 0:
             raise ValueError("qty must be positive")
